<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>41531ca3-87cf-4ee1-b4ca-b9319fe9a4c1</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>
    </StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>OpenCardTable.Server</Name>
    <RootNamespace>OpenCardTable.Server</RootNamespace>
    <InterpreterId>MSBuild|Scripts|$(MSBuildProjectFullPath)</InterpreterId>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="app\catalogs\local_catalog.py" />
    <Compile Include="app\catalogs\card_catalog.py" />
    <Compile Include="app\game\game_state.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="app\game\zone_container.py" />
    <Compile Include="app\game\zone.py" />
    <Compile Include="app\game\__init__.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="app\main.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="app\models\card_definition.py" />
    <Compile Include="app\models\card_instance.py" />
    <Compile Include="tests\acceptance\test_m1_acceptance.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="tests\unit\game\test_game_state.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="app\models\player.py" />
    <Compile Include="app\models\__init__.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="run_server.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="tests\unit\game\test_zone_container.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="tests\unit\models\test_player.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="tests\unit\models\test_card_instance.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="tests\unit\models\test_card_definition.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="tests\test_health.py">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include="..\.venv\Scripts\">
      <Id>Scripts</Id>
      <Version>3.13</Version>
      <Description>OpenCardTable .venv</Description>
      <InterpreterPath>python.exe</InterpreterPath>
      <WindowsInterpreterPath>pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="app\" />
    <Folder Include="app\game\" />
    <Folder Include="app\models\" />
    <Folder Include="app\catalogs\" />
    <Folder Include="tests\" />
    <Folder Include="tests\acceptance\" />
    <Folder Include="tests\integration\" />
    <Folder Include="tests\unit\" />
    <Folder Include="tests\unit\models\" />
    <Folder Include="tests\unit\game\" />
    <Folder Include="tests\unit\catalogs\" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
  <!-- Uncomment the CoreCompile target to enable the Build command in
       Visual Studio and specify your pre- and post-build commands in
       the BeforeBuild and AfterBuild targets below. -->
  <!--<Target Name="CoreCompile" />-->
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
</Project>